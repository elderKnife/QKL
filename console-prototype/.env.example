# Edge temporary outbox MySQL (existing mysql-data volume is retained)
MYSQL_ROOT_PASSWORD=replace-edge-root-password
MYSQL_PASSWORD=replace-edge-app-password
MYSQL_PORT=3307

# Independent VPP MySQL instance and volume
VPP_MYSQL_ROOT_PASSWORD=replace-vpp-root-password
VPP_MYSQL_PASSWORD=replace-vpp-app-password

# Independent GRID MySQL instance and volume
GRID_MYSQL_ROOT_PASSWORD=replace-grid-root-password
GRID_MYSQL_PASSWORD=replace-grid-app-password

# Local role accounts for the browser console
VPP_USERNAME=vpp
VPP_PASSWORD=replace-vpp-console-password
GRID_USERNAME=grid
GRID_PASSWORD=replace-grid-console-password

# Shared internal service credential; keep local and private
INTERNAL_CONTROL_TOKEN=replace-with-a-long-random-secret

# Default operation intervals (seconds)
SAMPLE_INTERVAL_SECONDS=600
BATCH_WINDOW_SECONDS=1800

# Host-only browser and diagnostic ports
EDGE_HEALTH_PORT=18080
VPP_PORT=18081
WEB_PORT=18082
